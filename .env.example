# Copy to .env (never commit .env)
PORT=8888          # used by `python run.py` outside Docker
HOST_PORT=8888     # host port published by docker compose
# DEBUG=1 enables Tornado autoreload and debug mode (never in production)
DEBUG=
# HSTS is OFF unless you set this (seconds, e.g. 3600). Browsers remember it and it cannot be undone remotely;
# only enable it when the whole host is served over HTTPS, and start with a small value.
HSTS_SECONDS=
# Adds includeSubDomains to HSTS (separate opt-in; forces https on every subdomain). Preload is never sent.
HSTS_INCLUDE_SUBDOMAINS=
# 1 = mark the XSRF cookie Secure (only when served over HTTPS)
SECURE_COOKIES=
